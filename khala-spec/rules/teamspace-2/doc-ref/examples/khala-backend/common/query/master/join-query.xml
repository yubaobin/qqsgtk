&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?&gt;
&lt;!DOCTYPE mapper PUBLIC &quot;-//mybatis.org//DTD Mapper 3.0//EN&quot;
        &quot;http://mybatis.org/dtd/mybatis-3-mapper.dtd&quot;&gt;
&lt;mapper namespace=&quot;com.example.query.SysUserJoinMapper&quot;&gt;

    &lt;!-- 一对一：用户 + 部门 --&gt;
    &lt;resultMap id=&quot;userDeptMap&quot; type=&quot;com.example.query.UserDeptDTO&quot;&gt;
        &lt;id column=&quot;user_id&quot; property=&quot;userId&quot;/&gt;
        &lt;result column=&quot;username&quot; property=&quot;username&quot;/&gt;
        &lt;result column=&quot;email&quot; property=&quot;email&quot;/&gt;
        &lt;result column=&quot;dept_id&quot; property=&quot;deptId&quot;/&gt;
        &lt;result column=&quot;dept_name&quot; property=&quot;deptName&quot;/&gt;
    &lt;/resultMap&gt;

    &lt;select id=&quot;selectUserWithDept&quot; resultMap=&quot;userDeptMap&quot;&gt;
        SELECT
            u.id AS user_id,
            u.username,
            u.email,
            d.id AS dept_id,
            d.dept_name
        FROM sys_user u
        LEFT JOIN sys_dept d ON u.dept_id = d.id
        WHERE u.id = #{userId}
    &lt;/select&gt;

    &lt;!-- 一对多：部门 + 用户列表 --&gt;
    &lt;resultMap id=&quot;deptUserMap&quot; type=&quot;com.example.query.DeptUserDTO&quot;&gt;
        &lt;id column=&quot;dept_id&quot; property=&quot;deptId&quot;/&gt;
        &lt;result column=&quot;dept_name&quot; property=&quot;deptName&quot;/&gt;
        &lt;collection property=&quot;users&quot; ofType=&quot;com.example.query.UserSimpleDTO&quot;&gt;
            &lt;id column=&quot;user_id&quot; property=&quot;userId&quot;/&gt;
            &lt;result column=&quot;username&quot; property=&quot;username&quot;/&gt;
        &lt;/collection&gt;
    &lt;/resultMap&gt;

    &lt;select id=&quot;selectDeptWithUsers&quot; resultMap=&quot;deptUserMap&quot;&gt;
        SELECT
            d.id AS dept_id,
            d.dept_name,
            u.id AS user_id,
            u.username
        FROM sys_dept d
        LEFT JOIN sys_user u ON d.id = u.dept_id
        WHERE d.id = #{deptId}
    &lt;/select&gt;

    &lt;!-- 三表联查：用户 + 部门 + 角色 --&gt;
    &lt;resultMap id=&quot;userDetailMap&quot; type=&quot;com.example.query.UserDetailDTO&quot;&gt;
        &lt;id column=&quot;user_id&quot; property=&quot;userId&quot;/&gt;
        &lt;result column=&quot;username&quot; property=&quot;username&quot;/&gt;
        &lt;result column=&quot;dept_name&quot; property=&quot;deptName&quot;/&gt;
        &lt;result column=&quot;role_name&quot; property=&quot;roleName&quot;/&gt;
    &lt;/resultMap&gt;

    &lt;select id=&quot;selectUserDetail&quot; resultMap=&quot;userDetailMap&quot;&gt;
        SELECT
            u.id AS user_id,
            u.username,
            d.dept_name,
            r.role_name
        FROM sys_user u
        LEFT JOIN sys_dept d ON u.dept_id = d.id
        LEFT JOIN sys_user_role ur ON u.id = ur.user_id
        LEFT JOIN sys_role r ON ur.role_id = r.id
        &lt;where&gt;
            &lt;if test=&quot;username != null and username != &#39;&#39;&quot;&gt;
                AND u.username LIKE CONCAT(&#39;%&#39;, #{username}, &#39;%&#39;)
            &lt;/if&gt;
        &lt;/where&gt;
    &lt;/select&gt;

&lt;/mapper&gt;
